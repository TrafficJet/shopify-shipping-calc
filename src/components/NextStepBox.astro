---
// Monetization CTA shown right under calculator results.
// Renders nothing until the affiliate URL is configured in src/data/affiliates.ts.
import { AFFILIATES, withUtm } from '../data/affiliates';

interface Props {
  headline: string;
  body: string;
  ctaText: string;
  utmContent: string;
  offer?: 'shipping' | 'shopify';
}
const { headline, body, ctaText, utmContent, offer = 'shipping' } = Astro.props;

const baseUrl = offer === 'shopify' ? AFFILIATES.SHOPIFY_URL : AFFILIATES.SHIPPING_SOFT_URL;
const href = withUtm(baseUrl, utmContent);
---
{href && (
  <div class="mt-6 p-6 rounded-2xl border-2 border-teal-200 bg-teal-50 dark:bg-teal-950 dark:border-teal-800">
    <h3 class="text-lg font-bold text-teal-900 dark:text-teal-100 mb-1">{headline}</h3>
    <p class="text-sm text-teal-800 dark:text-teal-200 mb-4">{body}</p>
    <a href={href} rel="sponsored nofollow noopener" target="_blank"
       class="inline-block bg-teal-600 hover:bg-teal-700 text-white font-semibold px-6 py-3 rounded-lg transition-colors">
      {ctaText} →
    </a>
    <p class="mt-3 text-xs text-teal-700/70 dark:text-teal-300/70">
      We may earn a referral fee — see our <a href="/disclosure" class="underline">disclosure</a>.
    </p>
  </div>
)}
